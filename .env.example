# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
# Comma-separated hosts Django will answer to (localhost is added automatically when DEBUG=True).
# In production set this to your backend's domain, e.g. masar-backend.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend URLs allowed to call the API (comma-separated, NO trailing slash).
# In production set this to your deployed frontend, e.g. https://masar-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_NAME=masar_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# AI chatbot
ANTHROPIC_API_KEY=your-anthropic-key-here

# Deployment / Docker only
# Set to true ONCE on a fresh deployed database to load the demo students; it is
# skipped automatically if the database already has data.
SEED_ON_START=false